# RWA低效资产管理系统 - 环境变量配置

# 数据库配置
DATABASE_URL=sqlite:///./data/rwa_assets.db

# 区块链配置
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_NETWORK=localhost
CHAIN_ID=1337

# 合约地址（部署后填写）
ASSET_NFT_CONTRACT=
ASSET_TOKEN_CONTRACT=

# 私钥（注意安全，不要提交到代码库）
PRIVATE_KEY=

# API配置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# IPFS配置（用于存储元数据）
IPFS_GATEWAY=https://ipfs.io
IPFS_API_URL=http://localhost:5001

# 估值模型参数
DEFAULT_DISCOUNT_RATE=0.08
DEFAULT_TERMINAL_GROWTH_RATE=0.02
DEFAULT_CAP_RATE=0.06

# 风险评估参数
HISTORICAL_DEFAULT_RATE=0.05
DEFAULT_RECOVERY_RATE=0.40

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/rwa_system.log

# JWT密钥（用于身份验证）
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# 外部API（可选）
# MARKET_DATA_API_KEY=
# CREDIT_BUREAU_API_KEY=
